book_writing_llm: ollama local model ornith-1.5:35b
book_directory: {diretory_of_this_prompt}/../.chat/books
words_per_chapter: 800
max_number_of_chapters: 10
articles_to_learn: 40

task.load_a_book (completed) {
  reference task.books_command:
  - when clicking on each book url, open up a modal and show the book content, similar to opening up individual news search result
}

task.keywords (completed) {
  once we have the keywords, when searching like /news search, add plus sign between keywords:
  for example:
  keywords: japan driving guide for beginner 
  actual keywords: japan+driving+guide+for+beginner
}

task (completed) {
  update {articles_to_learn}
}

task (completed) {
  reference task.write_a_book:
  - for lists_of_knowledge, learn from /news search {keywords}, but only target on results that are from the pass 2 years only, only extract top {articles_to_learn} results
}

task (completed) {
  reference task.write_a_book:
  - update {book_directory}  
  - each book should have between 3 to {max_number_of_chapters}
  - each chapter should have about {words_per_chapter}
}

task.write_a_book (completed) {
  command: /write_a_book <subject> {
    keywords: based on <subject>, use {book_writing_llm} to construct one list of keywords i should search
    lists_of_knowledge: learn from /new search {keywords}, but only target on results that are from the pass 2 years only, only extract top 10 results
    learn all the text in {lists_of_knowledge}
    write a book chapter by chapter, each chapter has maximum 600 words
    save the book to {book_directory}/{subject}.html
  }
}

task.books_command (completed) {
  create a command: /books {
    - list all the books in {book_directory}
  }
}
