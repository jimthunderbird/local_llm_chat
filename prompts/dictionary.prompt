dictionary_llm: ollama local model ornith-1.5:35b with no thinking

dictionary_history_directory: {directory_of_this_prompt}/../.chat/dictionary_history

task.highlight_word_in_context_and_meaning (completed) {
  for each entry in /dictionary_history command:
  - highligh the word in its related context and meaning section
}

task.do_not_scroll_on_dictionary_history (completed) {
  after typing /dictionary_history, do not scroll
}

task.colins_cobuild_style_explanation (completed) {
  currently, the dictionary popup looks like:
  Contextual Meaning: <word> means that ...
  - please remove the "<word> means that" wording
  - please simulate colin's cobuild dictionary explanation style, the definitions are restricted to a carefully curated set of roughly 2,500 of the most common and simple English words
  - UI format {
    - Word: <word>
    - IPA: <IPA>
    - Part of Speech: <PART OF SPEECH>
    - Synonym: <Synomyms>
    - Meaning: <DEFINITION using roughly 2500 most common and simple english words>
    - Context: <The Context>
    - Sentences: <2 Sample Sentences of the <word> reflecting this meaning>
  }
}

task.dictionary_history_list_ui.font (completed) {
  refer to {task.dictionary_history_list_ui.dictionary_searchable}:
  - make the meaning and context word font size as the word font size
}

task.dictionary_history_list_ui.dictionary_searchable (completed) {
  refer to {task.dictionary_history_list_ui.dictionary_searchable}:
  - make each word also dictionary searchable in UI
}

task.dictionary_history_list_ui (completed) {
  after typing /dictionary_history, for each {word}, present:
  - {word} in bold font
  - meaning (in bold font): the {word}'s meaning
  - context (in bold font): the {word}'s context
}

task.dictionary_history (completed) {
  - for each dictionary inquery, add or update an entry in {directory_of_this_prompt}/../.chat/dictionary_history/<word>.json, it should contain [
    {
      context: <20 words before the word> <word> <20 words after the word>
      meaning: <the word's meaning in this context>
    }
  ]
  - create a command: /dictionary_history {
    it will show the top 300 words history by doing find {dictionary_history_directory} -type f -name "*.json" -exec stat -f "%m %N" {} + | sort -rn | cut -d' ' -f2- | head -n 300
  }
}

