research_llm: ollama local model ornith-1.5:35b

hospital_map {
  UCSF: ucsf.edu, ucsfhealth.org
}

task.refactor.initial_command_logic (completed) {
  reference task.initial_command_logic:
  change logic.fetch_news_and_produce_answer {
    - DO NOT NEED TO find out related questions for <topic>
    - learn from /news search <topic>, we are going to use /news search <topic>, get the top 4 news and put them into context
    - based on context: tell me about the <topic> in 100-150 words 
  }
}

task.question_source_fine_tuning.no_context_fall_back_to_news_search (completed) {
  - if a <topic> is about general facts, and even though there are matching wikipedia articles, but if the provided article does not have enough information to answer the <topic>, fall back to news search
}


task.question_source_fine_tuning.fallback (completed) {
  - if a <topic> is about general facts and there are no related information in wikipedia, fall back to news search
}

task.news_source_timeline (completed) {
  reference task.sources_of_the_answer:
  - next to the "Sources" icon, show me a from and to time of the related articles, format: From <from_time> To <to_time>
}

task.online_knowledge_mode_and_local_knowledge_mode (completed) {
  - in the main chat window, on the left side of the "INSERT" button, add a dropdown with the following {
    label: Mode
    options {
      - Online (default):
      - This will essentially equas to running /research_with_the_news on
      - Local:
      - This will essentially equas to running /research_with_the_news off
    }
  }
  - in the chat status bar, indict whethere is research mode is on or not
}

task.add_research_mode_on_option (completed) {
  allow turning on research mode using:
  /research_with_the_news on
}

task.sources_of_the_answer (completed) {
  - below each answer, show an icon for sources of news article the answer is based on, when click {
    - show a popup modal showing list of related article urls
  }
}

task.dictionary_searchable (completed) {
  - make each word in the answer dictionary searchable
}

task.question_source_fine_tuning.doctors (completed) {
  - if <topic> is about a specific Dr, do the following:
  hospitals: find the doctor's hospital based on {hospital_map}
  titles: get all related articles's titles by searching <the doctor's name> in each one of <hospitals>
  articles: baed on the {titles}, try to pick the articles that with the title containing <the doctor's name>
  add {articles} to the context and answer the question
}

task.question_source_fine_tuning (completed) {
  - if a <topic> is about general facts, for example:
  - what is donald trump's birthday?
  - what does nvidia do?
  restrict the news search to en.wikipedia.org, get the wikipedia article and add to the context

}

task (completed) {
  when RESEARCH_WITH_NEWS_MODE is off, the previous accumulated context should be cleared
}

task.keep_track_of_previous_context (completed) {
  when RESEARCH_WITH_NEWS_MODE is on:
  for each {question} all subsequent questions {
    - each relevant question for {question} that we are going to search using "/news search" should be related to the current accumulated context
  }
}

task.initial_command_logic (completed) {
  create command /research_with_the_news <topic> {
    - starting RESEARCH_WITH_NEWS_MODE, and it will be set to be "on"
    when RESEARCH_WITH_NEWS_MODE is on {
      - clear all existing context, starting a clean context
      logic.fetch_news_and_produce_answer {
        - related_questions: use {research_llm} to come up with 2 most relevant questions regarding the topic, thse questions should not have any time/year information, we need to hyper focus on the <topic>
        - learn from /news search <keywords>, we are going to use /news search {related_questions}, for each question, get the top 3 news and put them into context
        - based on context: tell me about the <topic> in 100-250 words 
      }
      - there might be subsequent follow-up questions, for each question, treat it as a single <topic> and repeat logic.fetch_news_and_produce_answer
    }

    - to turn off RESEARCH_WITH_NEWS_MODE, we can do: /research_with_the_news off
    when RESEARCH_WITH_NEWS_MODE is off, we are back to normal chat process
  }
}
