  create ./create_embeddings.py:
  - it should have one cil argument <youtube_video_hash>
  - logic:
  - remove all existing ./.chat/youtube_transcripts/<youtube_video_hash>.*.embedding files
  - for all {trunk_file}, {trunk_file_index_starting_from_1} in ./.chat/youtube_transcripts/<youtube_video_hash>.*.trunk:
  - embedding: use ollama local model embeddinggemma-2:570m to create an embedding for {the content of {trunk_file}}
  - save {embedding} to ./.chat/youtube_transcripts/<youtube_video_hash>.{trunk_file_index_starting_from_1}.embedding
}

task (completed) {
  create ./create_trunks.py:
  - it should have one cil argument <youtube_video_hash>
  - logic:
  - remove all existing ./.chat/youtube_transcripts/<youtube_video_hash>.*.trunk files
  - rewritten_content: read the content of ./.chat/youtube_transcripts/<youtube_video_hash>.rewrite
  for each {paragraph}, {paragraph_index_starting_from_1} in {rewritten_content}:
  - paragraph: trim all spaces and new lines around {paragraph}
  - trunk: 
  <article><title>{content of ./.chat/youtube_transcripts/<youtube_video_hash>.title}</title><paragraph>{paragraph}</paragraph></article>
  - save {trunk} to ./.chat/youtube_transcripts/<youtube_video_hash>.{paragraph_index_starting_from_1}.trunk
}

task (completed) {
